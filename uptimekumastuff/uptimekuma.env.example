# Uptime-Kuma export/import — instance and credentials.
# Copy to uptimekuma.local.env (gitignored via *.local.*) and fill in:
#   cp uptimekumastuff/uptimekuma.env.example uptimekumastuff/uptimekuma.local.env
#
# The scripts load this file themselves (python-dotenv); no `set -a` needed. It is
# looked for FIRST in the current working directory, THEN in the package directory
# (uptimekumastuff/) — the first hit wins, so a per-deployment file next to your
# state YAML overrides the packaged one. Real environment variables beat both, as do
# --username / --password.
#
# NOTE: the Socket.IO login does NOT accept API keys — use a real user account.

# Fallback for --url. An explicitly passed --url and the `url:` of a state YAML both
# take precedence, so this can never silently redirect a run at another instance.
UPTIME_KUMA_URL=https://uptimekuma.example.lan

UPTIME_KUMA_USERNAME=admin
UPTIME_KUMA_PASSWORD=CHANGE_ME
